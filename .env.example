# eBook Translate managed installer configuration.
# Keep the full Git checkout (including .git). On stock Unraid, ./btctl uses
# Docker automatically and does not require host Python, Git, or NerdTools.
# Copy this file outside the checkout, edit it, then run:
#   ./btctl plan --env /absolute/path/install.env
# Never commit the edited file: it can contain LLM_API_KEY.

# unraid | compose-existing (the stock reader always remains external)
BT_INSTALL_PROFILE=unraid
BT_INSTALL_NAME=cwa-translate

# published exposes only the injection proxy on BT_PROXY_PORT.
# docker-edge publishes no host port and requires BT_EDGE_NETWORK.
BT_INGRESS_MODE=published
BT_PROXY_PORT=8385
BT_EDGE_NETWORK=

# Safe CWA default: the API exchanges the browser's native reader proof for a
# five-minute, HttpOnly translator session. Kavita requires reader-session;
# see docs/install/kavita.md for the exact replacement block.
# Advanced SSO uses authentik-forwarded; see docs/install/authentik.md.
BT_AUTH_PROFILE=cwa-session
BT_PUBLIC_ORIGIN=https://books.example.com

# Existing stock reader identity and connectivity. These reader-neutral names
# are required for Kavita and preferred for new CWA installs. The legacy CWA_*
# aliases remain accepted for schema-1 CWA configuration compatibility.
BT_READER_TYPE=cwa
BT_READER_UPSTREAM=http://calibre-web-automated:8083
BT_READER_CONTAINER=calibre-web-automated
BT_READER_NETWORK=cwa_default
BT_READER_VERSION=4.0.6
# Optional immutable fallback when the running reader uses a mutable tag such
# as :latest. Set it to the exact `docker inspect .Image` sha256 value.
BT_READER_IMAGE_ID=
# Must match CWA's configured reverse-proxy login header. The managed proxy
# strips this exact client-supplied credential. Remove the value for Kavita.
BT_CWA_IDENTITY_HEADER=Remote-User

# Unraid paths require an existing /mnt/user/<share>/ or /mnt/<pool>/ root.
# Keep mutable state, translation data, and backups outside this Git checkout.
BT_STATE_DIR=/mnt/user/appdata/cwa-translate/state
BT_DATA_DIR=/mnt/user/appdata/cwa-translate/data
BT_BACKUP_DIR=/mnt/user/backups/cwa-translate
BT_UNRAID_TEMPLATE_DIR=/boot/config/plugins/dockerMan/templates-user

# Local OpenAI-compatible backend (vLLM, LM Studio, Ollama, llama.cpp).
LLM_PROVIDER=local
LLM_MODEL=gemma4-12b
BT_LOCAL_URL=http://192.168.1.50:8000/v1/chat/completions
LLM_API_KEY=

# Authentik-forwarded only. Leave empty for cwa-session.
BT_IDENTITY_PROXY_IP=
BT_AUTHENTIK_VERSION=
BT_AUTHENTIK_OUTPOST_URL=
BT_REVERSE_PROXY=

# Required only by `btctl upgrade` from an exact v2.1.4 container.
BT_LEGACY_CONTAINER=
BT_LEGACY_DATA_DIR=
