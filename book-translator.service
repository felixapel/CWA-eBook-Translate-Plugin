[Unit]
Description=book-translator — ebook paragraph translation service (multi-backend)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/hermes/.hermes/projects/book-translator
ExecStart=/home/hermes/.hermes/projects/book-translator/.venv/bin/gunicorn -w 2 -b 0.0.0.0:8390 --timeout 120 server:app
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Environment for MiniMax API
Environment=HOME=/home/hermes

[Install]
WantedBy=default.target
