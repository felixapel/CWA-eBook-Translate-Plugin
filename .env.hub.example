# Universal CWA + Kavita deployment. Copy to .env.hub, keep mode 0600, and
# never commit the edited file because it can contain provider API keys.
BT_HUB_ENV_FILE=.env.hub
BT_TOPOLOGY=hub
BT_IMAGE=cwa-ebook-translate-plugin:local
BT_INSTALL_NAME=book-translator-hub
BT_INSTALL_PROFILE=compose-existing
BT_STATE_DIR=/absolute/private/path/hub-state
BT_DATA_DIR=/absolute/private/path/hub-data
BT_BACKUP_DIR=/absolute/private/path/hub-backups

# Enable either reader or both. The stock readers remain external and must be
# reachable by container name on these exact existing Docker networks.
BT_ENABLE_CWA=true
BT_CWA_PUBLIC_ORIGIN=https://books.example.com
BT_CWA_READER_UPSTREAM=http://calibre-web-automated:8083
BT_CWA_READER_CONTAINER=calibre-web-automated
BT_CWA_READER_NETWORK=cwa_default
BT_CWA_READER_VERSION=4.0.6
BT_CWA_AUTH_PROFILE=reader-session
BT_CWA_READER_CONNECTOR_ID=01234567-89ab-4cde-8123-0123456789ab
BT_CWA_PUBLISHED_PORT=8385

BT_ENABLE_KAVITA=true
BT_KAVITA_PUBLIC_ORIGIN=https://kavita.example.com
BT_KAVITA_READER_UPSTREAM=http://kavita:5000
BT_KAVITA_READER_CONTAINER=kavita
BT_KAVITA_READER_NETWORK=kavita_default
BT_KAVITA_READER_VERSION=0.9.0.2
BT_KAVITA_AUTH_PROFILE=reader-session
BT_KAVITA_READER_CONNECTOR_ID=11234567-89ab-4cde-8123-0123456789ab
BT_KAVITA_PUBLISHED_PORT=8386

# Shared provider defaults. Supported named API providers include gemini,
# openai, anthropic, groq, together, minimax, deepseek, and openrouter.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=
BT_LOCAL_URL=

# Optional per-reader override. Every present value replaces the shared value;
# an explicitly empty API key clears the inherited secret for a local backend.
# BT_KAVITA_LLM_PROVIDER=local
# BT_KAVITA_LLM_MODEL=gemma4-12b
# BT_KAVITA_LLM_API_KEY=
# BT_KAVITA_LOCAL_URL=http://host.docker.internal:8000/v1/chat/completions

# Hub-wide budgets are split fairly unless every enabled reader supplies an
# explicit BT_<READER>_MAX_* allocation whose sum does not exceed the total.
BT_MAX_CONCURRENT=2
BT_MAX_UPSTREAM_INFLIGHT=2
BT_TIMEOUT=60
BT_REQUEST_DEADLINE_SECONDS=90
BT_CACHE_TTL_DAYS=90
BT_CACHE_MAX_ENTRIES=100000
