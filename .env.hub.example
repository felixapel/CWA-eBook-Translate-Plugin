# ==============================================================================
# eBook Translate (Book Translator Hub) — Environment Configuration
# High-Throughput & Universal Multi-Reader Setup (CWA & Kavita)
# ==============================================================================

# --- Reader Integrations ---
BT_ENABLE_CWA=true
BT_ENABLE_KAVITA=true
BT_ROLE=api
BT_AUTH_MODE=disabled
BT_ALLOW_INSECURE_AUTH=true

# --- Unified Ports ---
PORT=8390
BT_PROXY_PORT=8080

# --- LLM Provider & Routing ---
# Recommended Providers: local (Bifrost/vLLM), groq, gemini, cerebras, mistral, openai
LLM_PROVIDER=local
BT_LOCAL_URL=http://192.168.0.122:8082/v1/chat/completions
LLM_MODEL=groq/openai/gpt-oss-120b

# --- High-Throughput Batching Economics ---
# Sweet spot empirically tested for 0% segment loss and < 2s latency
BT_BATCH_SIZE=20
BT_BATCH_SOURCE_TOKEN_BUDGET=1400
BT_BATCH_MAX_TOKENS=3500
BT_TIMEOUT=90
BT_MAX_CONCURRENT=4
BT_MAX_UPSTREAM_INFLIGHT=4
BT_CLIENT_PREFETCH_GAP_MS=500
BT_MAX_BATCH_PARAGRAPHS=50

# --- SQLite Performance (WAL Mode) ---
# PRAGMA journal_mode=WAL; PRAGMA synchronous=NORMAL; PRAGMA busy_timeout=5000;
